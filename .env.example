# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret used to sign HttpOnly session cookies.
# Always set a strong random string in production.
SESSION_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# ADMIN_INITIAL_USERNAME / ADMIN_INITIAL_PASSWORD:
# Used only on initial server bootstrap when no admin account exists in the DB.
# Change the admin password immediately after first login before production.
ADMIN_INITIAL_USERNAME="Admin"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_BEFORE_PRODUCTION"

# DB_PATH: Optional path to the persistent SQLite database file.
DB_PATH="./data/casatech.db"

# PAYMENT_GATEWAY_ENABLED: Set to true only after configuring a Moroccan PSP (CMI / Payzone).
PAYMENT_GATEWAY_ENABLED="false"
